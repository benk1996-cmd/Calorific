OPENROUTER_API_KEY=
# Comma-separated, best first. Avoid models that force reasoning on (the app turns it off): e.g. openrouter/free.
VISION_MODELS=nvidia/nemotron-3.5-super-vl:free
TEXT_MODELS=
# Seconds to wait for one model request before retrying (default 25)
LLM_TIMEOUT_S=25
USDA_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_EMAILS=
ANALYZE_DAILY_LIMIT_GLOBAL=45
ANALYZE_DAILY_LIMIT_PER_USER=10
RESOLVER_THRESHOLD=0.45
RESOLVER_LLM_PICK=false
# Mock OpenRouter during development so the 50/day free quota isn't spent
LLM_MOCK=true
# Frontend (exposed to browser; anon key only, never the service-role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
APP_URL=http://localhost:5173
# Calculator tuning (optional)
RICE_KCAL_SHARE=0.5
LESS_RICE_FACTOR=0.5
NO_SUGAR_REMOVAL=0.8
SIEW_DAI_REMOVAL=0.4
